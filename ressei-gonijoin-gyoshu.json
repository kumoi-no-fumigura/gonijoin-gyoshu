  {
   "seq": "4",
   "text": "ゆくかたはそことも知らず難波舟わくるあし間も深き霞に",
   "kana": "",
   "speaker": "",
   "page": 148,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "降る雪に色はまがひぬしかはあれど匂ふや梅のしるしなるらむ",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "とがむなよ誰が垣根とは知らねどもあかぬ餘に手折る梅が枝",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "かへる雁おのがこし路のとほければまだ曙のみやこ出づなり",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "吹く風もいとふひとなき山陰にこころと殘るはなのひともと",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "吹く風に知られぬ山のさくら花こころづからの色やのこれる",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "をしむにはなどかとまらぬ鶯のおのがねにこそ春もたちしか",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "山ざくらくれなばなげと思ふより宿をば花のかげをしめてき",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あかなくに散りにし花の面影をなほみよし野の山の端のくも",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "物ごとに改まるてふ春なれどいづらかすみの去年にかはれる",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "谷を出でし頃にぞ似たるうぐひすのおのが羽風の花のしら雪",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "すがの根の長き春日もかぎりあれば夕ぐれ告ぐるいり相の鐘",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "あかなくにをりはつくさじ山櫻またこむ春をはなにちぎりて",
   "kana": "",
   "speaker": "",
   "page": 149,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "散るまでもながめすてじと山櫻ひと木のかげに日數へにけり",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "人はこずさそふ風だに音たえて心とにはにちるさくらかな",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "昨日今日みはしの春の花ざかり散らぬまゆるす朝ぎよめかな",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "村雨のなごりのこずゑはれそめてみね高くなくほととぎす哉",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "昨日までみやこに待ちしほととぎすけふこの宿に初音ききつる",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あしの葉におく白露の玉江にはいとどほたるの影ぞみだるる",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "つれなさもなほうかるべし郭公ききつと告ぐる人なからなむ",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "あすか河昨日のふちは今日もなほ瀨になりがたき五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "うたた寐はしばしと思ふかたしきの袖にあやなくあくる月影",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "村雨のはるる梢のやまたかみ凉しきつゆにせみぞなくなる",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "心あらば河浪たつな天の川ふなでまつせのあきのゆふかぜ",
   "kana": "",
   "speaker": "",
   "page": 150,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "七夕のこころとまれに逢ふ夜半はつもる月日を恨みしもせじ",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "袖ふるはほのかに見えてたなばたの歸る八十瀨の浪ぞあけゆく",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "散らざらば折りてゆかまし萩が花うつろふ露を見ぬ人のため",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "心あらば月まつかたのそらばかり山の端はれよあきのゆふ霧",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "立ちかくすそがの河原のかは霧にますげも見えぬ秋のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "秋風に夜寒のつきはかげもりて床あらはなるあさぢふのやど",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "長月のあきのしぐれは久方のつきのかつらをそむるなりけり",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "さやかなる絕間ばかりはすくなくて浮雲つたふあきの夜の月",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "波の音も夜はふけぬらし舟とむる月の入江のあきのうらかぜ",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あしびきの山より月は出でにけり松にかつらの枝をまじへて",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "いるほどをいかでとめまし山の端に待つはたのみも有明の月",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "栽ゑてみるわれも千年をへぬべきは老いせぬきくの花の上の露",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "見る人のねぬよのころも音すなりたよりも月になほやうつらむ",
   "kana": "",
   "speaker": "",
   "page": 151,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "なにせむに月になれける我が身ぞとくやしきまでにをしき秋哉",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "をしみかねこよひの秋はあけぬとも明日のわかれの曉のそら",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "あま小舟こぎゆく波のをちかたに聲をほにあげて雁もなくなり",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "夜もすがら音ぞたゆまぬ月かげにあくるまでとや衣うつらむ",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "み山にもすめば住まるる秋なれやあはれにたへで鹿のなくなる",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "長月のありあけの月のなごりをも今はしぐれに誰れながむらむ",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "今よりは夜寒のしぐれふりそめて秋の日數もあらし吹くなり",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "枝ながら見むよりはなほ白露のけぬとも折らむ秋はぎの花",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "ほしわびぬささわくる野の白露にぬれての後のそでの月かげ",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "おなじくば千年もゆづれ山路よりねこじてうゑしやどの白菊",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "さをしかは妻こひわびぬ草がれの小野の夜さむの秋風のころ",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "たきつせの音こそたえね吉野川月のむすべるあきのこほりに",
   "kana": "",
   "speaker": "",
   "page": 152,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "われならぬ人もねぬ夜やふけぬらむ惜しと思ふ月に衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "月にそふ秋風もがなあまの原あたりもつらき雲やはるると",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "さよ千鳥友よびかはす〓き瀨にますげみだるるそがの河かぜ",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "み吉野の雪氣のあらしさむからしきさの中山しぐれ降るころ",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "和田の原夕日のすゑの波の上にくもりてわたる村しぐれかな",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "峯の雲ふもとの紅葉吹きまぜてあらしより降る村しぐれかな",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "おく露はあだのおほ野とみし秋の霜のまくずに嵐吹くなり",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "夕されば寒き野風の霜のしたに枯れても殘る荻のおとかな",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "吹く風にちりかひくもる冬の夜の月のかつらの花のしらゆき",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "夕しほのさしける跡と見ゆるかなみぎはをおきてつもる白雪",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "たまくらの閨のすき間の山嵐に袖までさゆる夜半のしもかな",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "住吉の松のいはねのおきつなみこほりを月によするうらかぜ",
   "kana": "",
   "speaker": "",
   "page": 153,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "白露の玉ぬきかけし面影のあられにのこる眞野のはぎはら",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "白雪のふるかは野邊の朝ぼらけいづこなるらむ二本のすぎ",
   "kana": "",
   "speaker": "ぬる人もありなまし雪ふりつもるみ吉野の山",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "時しらぬ名もふりにける富士の峯の雪にかさねてふれる白雪",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "うちなびく末葉ながらにやだの野の淺茅かくるる今朝の白雪",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "鳴く千鳥友よぶこゑもふけはてぬ霜夜の月のすまのうらなみ",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "あらし吹くひと村雲の山めぐり殘る木の葉やしぐれそふらむ",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "今は早うらみはつべきつれなさをしのぶにゆるす我が心かな",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "ながらへてあらばあふ世と賴む身のいかがはすべき憂にたへずば",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "命こそ契なりけれこひしなばありしながらやへだてはてまし",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "命あればまたもあふ世にめぐりきてふたたび鷄の音をぞ恨むる",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "思はすよねくたれ災の手枕にまだかきやらむちぎりありとは",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "年ふとも人にかたるな知るといへば袖ばかりにはゆるす涙を",
   "kana": "",
   "speaker": "",
   "page": 154,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "忘らるる身をこそ月にかこちつれ人をうらみぬ心よわさに",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "戀しさのなぐさめ難き光かな見しおなじよに月はかはらで",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "誰が袖にかげかよふとも夜半の月涙ありとはひとに語るな",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "うき人の同じながめの月なればつらし我が身の袖にやどさじ",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "色に出でむたよりをぞ待つむらさきの一本ゆゑを尋ねそめつつ",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "ちぎれどもまたいかならむとばかりに賴めもはてぬ夕暮の空",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "顯ればこの世にだにも生けらじと誓ひてし身もながらへにけり",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "あはれにも道の芝草しげるかなつゆうちはらひ通ひしものを",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "せく涙たのむ枕のそれさへや袖よりほかにまたも朽ちなむ",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "音にたてて戀ひぞわびぬる唐琴のおのづからだにあふ夜なければ",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "をしからず思ひよわらぬわが命今日逢ふこととかへて捨てむは",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "人傳も今ぞくやしきもりし名はそれゆゑとのみかこちなされて",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "よしさらばたえぬるかたは歎かじよ忍びはてしを情にはして",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "かはらむにいけらばこそは契りしをよし恨みむと後も賴まめ",
   "kana": "",
   "speaker": "",
   "page": 155,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "戀しさのねてや忘ると思へどもまた名殘そふ夢のおもかげ",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "忘るやと思ふとだえも歎かれずさぞせきもりのぬる夜なからむ",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "日にそへて勝る夜がれのつらさにぞこれよりたえむ後は知らるる",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "ほのかにもまだ見ざりしを夢になしていかにぬる夜と猶や恨みむ",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "忍ぶれば名殘おほくていづる夜をいそぐわかれと人や恨みむ",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "うち出でてしらせやせまし沖つ波かかる思のしたにありとし",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "いかにせむわが心なる淚だに忍ばばともにうき名もらすな",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "いかにせむ逢ふ夜もなみのみをつくしよそに忍ぶのうらみだにせず",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "神垣にゆふしでかくる榊葉のかはらぬ中になびけとぞおもふ",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "つれなくて年ふるなかのしるしとは祈りやはせし三輪の神杉",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "まちわぶる心ひとつのくるしさもいはぬながめの夕ぐれの空",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "見るほどは夢とも知らぬ面影のさめてかなしきうたたねの床",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "賴めつつこぬ夜の床にこひしねとするわざならし君がつれなさ",
   "kana": "",
   "speaker": "",
   "page": 156,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "あふことを猶まつ身とや思ふらむ命ばかりのさてもたえずば",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "待ちなれし心ばかりはかはらねど人こそあらね夕ぐれのそら",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "契あれやいなの小篠のかりまくらそのひとふしは忘れしもせず",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "うかりける契はすゑの松山にあだしこころのなみこえにけり",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "曇らぬもくもるも同じなみだにてうき身にわかぬ袖の月かげ",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "つれなくて命もあらばありあけの月をふたたび別にや見む",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "思ひいでて同じ心にみる人はありやなしやと月にとはばや",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "かこつべき鷄の音もなしうたたねの夢にあふ夜のさむる別は",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "待ちわびて夕ぐれつもるいつはりは我が身やこりぬ人やつれなき",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "僞にふけゆくほどの知らるれば待つ夜は月の影をながめじ",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "人目にはいかにもらさむ月にこそ心よわさのなみだなりとも",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "わすれじと行末ちぎることの葉をおもひあはせむ命ともがな",
   "kana": "",
   "speaker": "",
   "page": 157,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "いつはりの言の葉だにもなき時ぞげに絕えはつる契とは知る",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "誰れかいとふ獨ぬる夜のねざめにはつらからで聞く鷄の八聲を",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "ふけにけりたれに契りて出でぬらむ人はつれなき山のはのつき",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "さめてなほ歎かむためか逢ふと見て人なきとこの夢の名殘は",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "いかにせむつらき心のはながたみめならぶ人にうつる契を",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "かひぞなき思はぬ中のあし垣は近きも遠きへだてとおもへば",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "窓はらふ竹の葉風の夜な夜なは心とさむる夢ぞすくなき",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "松の葉の雪かとみればしろたへに千年もきえぬつるの毛衣",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "とまるべき宿をあらしにこと問へばなほ山深しいりあひの鐘",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "はるかなる野原の末の夕けぶり立つをしるしに宿やからまし",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "みやこをば鳥の音またでいでつるを山路の末の橫雲の空",
   "kana": "",
   "speaker": "",
   "page": 158,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "さき草のみつ葉よつばに龜の尾やさかゆく宿と君は千世ませ",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "あしたづの聲ものどけし住の江のまつ程ひさに萬代やへむ",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "夕嵐のさむき林のむらすずめやどりあらそふこゑ聞ゆなり",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "あけぬればこぎわかれ行くとまり舟一夜の波の契をぞおもふ",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "谷ふかきつま木のみちの夕嵐もたもとにさむくかへる山人",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "行末のちとせをともにさかゆべき宿のしるしの軒のまつが枝",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "萬代もかくて經ぬべし竹の葉にかぜおとづるる春ののどけさ",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
